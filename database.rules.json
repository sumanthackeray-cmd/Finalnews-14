{
  "rules": {
    // User Profiles: Users can read and write only their own profiles
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    // Realtime Chats: Users can read and write only chats belonging to them
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && (!data.exists() || data.child('userId').val() == auth.uid) && (newData.child('userId').val() == auth.uid)"
      }
    }
  }
}
