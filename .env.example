## 🌐 Cloudflare / Vercel / Hosting Environment Variables
##
## When deploying to production (cv.vogats.com), set these environment
## variables in your hosting platform's dashboard (Cloudflare Pages, Vercel, etc).
## DO NOT commit your actual secret values. Copy this file and fill in real values locally.

# ── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# ── DeepSeek AI (Resume Generation) ───────────────────────────────────────────
# Get your key from https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key

# ── Cashfree Payment Gateway ────────────────────────────────────────────────────
#
# SANDBOX (Test) — use for development and testing:
# VITE_CASHFREE_APP_ID=TEST...
# VITE_CASHFREE_SECRET_KEY=cfsk_ma_test_...
# VITE_CASHFREE_ENV=sandbox
#
# PRODUCTION — set once your Cashfree account is activated:
# VITE_CASHFREE_APP_ID=10331895ce0b14893bcec0e665a9813301
# VITE_CASHFREE_SECRET_KEY=<your-production-secret-key>
# VITE_CASHFREE_ENV=production
#
VITE_CASHFREE_APP_ID=your_cashfree_app_id
VITE_CASHFREE_SECRET_KEY=your_cashfree_secret_key
VITE_CASHFREE_ENV=production

# ── App URLs ────────────────────────────────────────────────────────────────────
# MUST be HTTPS for Cashfree production return_url and webhooks
VITE_APP_URL=https://cv.vogats.com
